APP_ENV=development
APP_NAME=QuestionPulse API
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+asyncmy://questionpulse:questionpulse_dev@127.0.0.1:3307/questionpulse?charset=utf8mb4
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:15021,http://127.0.0.1:15021
MYSQL_DATABASE=questionpulse
MYSQL_USER=questionpulse
MYSQL_PASSWORD=questionpulse_dev
MYSQL_ROOT_PASSWORD=questionpulse_root_dev
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_POLYV_WATCH_BASE_URL=http://127.0.0.1:15021/index.html
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_POLYV_CHANNEL_ID=

# POLYV credentials must stay on the backend and out of Git.
POLYV_APP_ID=
POLYV_APP_SECRET=
POLYV_CHANNEL_ID=
POLYV_SESSION_ID=
POLYV_API_TIMEOUT_SECONDS=10

# Optional AI providers; the MVP must still work when these are empty.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_OUTPUT_TOKENS=1200

# Knowledge base / RAG. Generation uses the LLM API above; the embedding model
# runs in-process via fastembed and degrades to a hash embedder when absent.
KNOWLEDGE_STORAGE_PATH=../storage/knowledge
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=questionpulse_knowledge_v1
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=512
KNOWLEDGE_MAX_FILE_MB=50
KNOWLEDGE_WORKER_POLL_SECONDS=2
# Memory vector store loses data across the API/worker process split: test only.
KNOWLEDGE_ALLOW_MEMORY_VECTOR_STORE=false
KNOWLEDGE_JOB_LEASE_SECONDS=300
KNOWLEDGE_JOB_MAX_ATTEMPTS=3
RAG_TOP_K=20
RAG_CONTEXT_LIMIT=6
RAG_MIN_SCORE=0.35
RAG_TIMEOUT_SECONDS=30
RAG_MAX_OUTPUT_TOKENS=1500
ACCESS_TOKEN_TTL_HOURS=72
PARTICIPANT_PSEUDONYM_KEY=replace-with-a-private-random-value
TEACHER_USERNAME=0
TEACHER_PASSWORD=123456
TEACHER_PORTAL_SECRET=replace-with-a-private-random-value

