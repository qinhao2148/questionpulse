{
  "name": "questionpulse",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "build:frontend": "pnpm --dir frontend build",
    "typecheck:frontend": "pnpm --dir frontend typecheck",
    "check": "powershell -ExecutionPolicy Bypass -File scripts/check.ps1",
    "demo:start": "powershell -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "demo:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-demo.ps1",
    "demo:reset": "powershell -ExecutionPolicy Bypass -File scripts/reset-demo.ps1",
    "package:submission": "powershell -ExecutionPolicy Bypass -File scripts/package-submission.ps1"
  }
}

