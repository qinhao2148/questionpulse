{
  "manifest_version": 3,
  "name": "QuestionPulse Teacher Copilot",
  "version": "0.3.2",
  "description": "在 POLYV 网页开播台内查看并处理实时群体疑问。",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://live.polyv.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*"
      ],
      "js": ["pairing.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "QuestionPulse Teacher Copilot"
  }
}
